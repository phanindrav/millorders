<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Krishna Prabhas Agro Tech</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
  <header class="topbar">
    <div class="container-fluid d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-light btn-sm d-lg-none" id="menuToggle" type="button" aria-label="Toggle navigation">
          ☰
        </button>
        <div>
          <div class="brand">Krishna Prabhas Agro Tech</div>
          <div class="small opacity-75">Order management dashboard</div>
        </div>
      </div>
      <div class="topbar-meta d-flex gap-2 align-items-center">
        <span class="badge rounded-pill">Fast workflow</span>
        <span class="badge rounded-pill">Responsive UI</span>
      </div>
    </div>
  </header>

  <div class="page-shell">
    <aside class="sidebar-panel">
      <div class="sidebar-header">
        <h5>Navigation</h5>
        <p>Manage your orders and records</p>
      </div>
      <ul class="nav flex-column">
        <li class="nav-item">
          <a href="#" class="nav-link load-page active" data-page="/orders">Orders</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/agents">Agents</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/shops">Shops</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/items">Items</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/reports/agent">Reports</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/reports/agent-all/all">All Agents</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/reports/item-summary">Agent Report</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/reports/rice-report">Rice Report</a>
        </li>
        <li class="nav-item">
          <a href="#" class="nav-link load-page" data-page="/reports/daily-report">Daily Report</a>
        </li>
      </ul>
      <div class="sidebar-footer">
        Tip: Use the modules to manage daily orders, agents, and shop records efficiently.
      </div>
    </aside>

    <main class="content-panel">
      <div class="content-area">
        <div id="content-area"></div>
      </div>
    </main>
  </div>

  <script>
  function setActiveNav(page) {
    $(".load-page").removeClass("active");
    $(".load-page[data-page='" + page + "']").addClass("active");
  }

  $(document).on("click", ".load-page", function (e) {
    e.preventDefault();
    const page = $(this).data("page");
    setActiveNav(page);
    $(".sidebar-panel").removeClass("show-mobile");

    $("#content-area").html('<div class="loading-state">Loading content...</div>');

    $.get(page)
      .done(function (html) {
        $("#content-area").html(html);
      })
      .fail(function () {
        $("#content-area").html("<div class='alert alert-danger'>Unable to load this section right now.</div>");
      });
  });

  $(document).ready(function () {
    const defaultPage = "/reports/agent-all/all";
    setActiveNav(defaultPage);
    $("#menuToggle").on("click", function () {
      $(".sidebar-panel").toggleClass("show-mobile");
    });
    $("#content-area").html('<div class="loading-state">Loading dashboard content...</div>');

    $.get(defaultPage)
      .done(function (html) {
        $("#content-area").html(html);
      })
      .fail(function () {
        $("#content-area").html("<div class='alert alert-danger'>Unable to load the default dashboard view.</div>");
      });
  });
  </script>
</body>
</html>
