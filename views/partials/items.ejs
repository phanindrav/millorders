<div class="card-panel table-card">
  <div class="card-body p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
      <div>
        <h3 class="h4 mb-1">Manage Items</h3>
        <p class="text-muted mb-0">Keep your item catalog and brands organized.</p>
      </div>
      <span class="badge badge-soft rounded-pill">Catalog</span>
    </div>

    <form id="itemForm" class="row g-3 mb-4 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Item Name</label>
        <input type="text" class="form-control" name="Name" placeholder="Enter item name" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Brand</label>
        <input type="text" class="form-control" name="Brand" placeholder="Enter brand" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Add Item</button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table align-middle" id="itemsTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Brand</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editItemModalLabel">Edit Item</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editItemForm">
          <input type="hidden" id="editItemId" name="ItemId">
          <div class="mb-3">
            <label for="editName" class="form-label">Name</label>
            <input type="text" class="form-control" id="editName" name="Name" required>
          </div>
          <div class="mb-3">
            <label for="editBrand" class="form-label">Brand</label>
            <input type="text" class="form-control" id="editBrand" name="Brand" required>
          </div>
          <button type="submit" class="btn btn-success">Update</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
$(document).ready(function () {
  loadItems();

  function loadItems() {
    $.get('/api/items', function (data) {
      let rows = '';
      data.forEach(item => {
        rows += `
          <tr>
            <td>${item.ItemId}</td>
            <td>${item.Name}</td>
            <td>${item.Brand}</td>
            <td class="text-end">
              <button class="btn btn-sm btn-outline-warning me-2 editBtn" data-id="${item.ItemId}" data-name="${item.Name}" data-brand="${item.Brand}">Edit</button>
              <button class="btn btn-sm btn-outline-danger deleteBtn" data-id="${item.ItemId}">Delete</button>
            </td>
          </tr>`;
      });
      $('#itemsTable tbody').html(rows);
    });
  }

  $('#itemForm').submit(function (e) {
    e.preventDefault();
    $.post('/api/items', $(this).serialize(), function () {
      $('#itemForm')[0].reset();
      loadItems();
    });
  });

  $(document).on('click', '.editBtn', function () {
    $('#editItemId').val($(this).data('id'));
    $('#editName').val($(this).data('name'));
    $('#editBrand').val($(this).data('brand'));
    new bootstrap.Modal(document.getElementById('editItemModal')).show();
  });

  $('#editItemForm').submit(function (e) {
    e.preventDefault();
    const id = $('#editItemId').val();
    $.ajax({
      url: '/api/items/' + id,
      method: 'PUT',
      data: $(this).serialize(),
      success: function () {
        $('#editItemModal').modal('hide');
        loadItems();
      }
    });
  });

  $(document).on('click', '.deleteBtn', function () {
    if (confirm('Delete this item?')) {
      $.ajax({
        url: '/api/items/' + $(this).data('id'),
        method: 'DELETE',
        success: function () {
          loadItems();
        }
      });
    }
  });
});
</script>
